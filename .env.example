# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret-and-paste-it-here
# Public site URL used for canonical URLs / sitemap / OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB Atlas ---
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/apus?retryWrites=true&w=majority
MONGODB_URI=

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apus-media
# Public delivery domain, e.g. https://media.apusindustries.com  (or https://<account>.r2.dev)
R2_PUBLIC_URL=

# --- Seed admin (used ONLY by `npm run seed`; never commit real values) ---
# If these are set, the seed script creates/updates a super-admin user.
# If they are empty, the seed script seeds settings + services only and prints a warning.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Apus Admin

# --- Optional email (inquiry notifications) ---
# If unset, inquiries are stored in MongoDB and shown in the CRM only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=apusindustries1@gmail.com
